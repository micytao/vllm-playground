# Containerfile for vLLM Playground Web UI (OpenShift/Kubernetes)
# This builds the web UI that manages vLLM pods via Kubernetes API

FROM registry.fedoraproject.org/fedora-minimal:latest

USER 0

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    HOME=/home/playground \
    PYTHON_VERSION=3.12 \
    PATH="/usr/local/bin:/home/playground/.local/bin:$PATH"

# Install Python and dependencies
RUN microdnf install -y \
    python3.12 \
    git \
    curl \
    which \
    && microdnf clean all

# Create symlinks and bootstrap pip
RUN ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    python3.12 -m ensurepip --upgrade && \
    python3.12 -m pip install --upgrade pip

# Create non-root user
RUN useradd -m -u 1001 -g 0 -s /bin/bash playground && \
    chmod -R g=u /home/playground

# Set working directory
WORKDIR ${HOME}/vllm-playground

# Copy the whole project, not just a handful of loose files: app.py does
# `import vllm_playground.backend_registry`, `from . import image_catalog`,
# `.mcp_client`, etc., so it only works when it stays inside a real,
# importable vllm_playground/ package (settings_store.py, image_catalog.py,
# backend_registry.py, cli.py, mcp_client/, static/, assets/, index.html
# all have to ship together).
COPY --chown=1001:0 . ${HOME}/vllm-playground/

# Swap in the Kubernetes-specific container manager and its requirements.
# This build targets OpenShift/Kubernetes pod orchestration, so the
# Podman-based vllm_playground/container_manager.py is replaced with
# openshift/kubernetes_container_manager.py, which exposes the same
# `container_manager` singleton that app.py imports.
RUN cp ${HOME}/vllm-playground/openshift/kubernetes_container_manager.py \
       ${HOME}/vllm-playground/vllm_playground/container_manager.py && \
    cp ${HOME}/vllm-playground/openshift/requirements-k8s.txt \
       ${HOME}/vllm-playground/requirements.txt

# Install Python dependencies. `pip install .` installs the vllm_playground
# package itself so `python3.12 -m vllm_playground.app` below can import it.
RUN python3.12 -m pip install --no-cache-dir --upgrade pip && \
    python3.12 -m pip install --no-cache-dir -r ${HOME}/vllm-playground/requirements.txt && \
    python3.12 -m pip install --no-cache-dir ${HOME}/vllm-playground/

# Make playground directory accessible
RUN chmod -R 775 ${HOME}/vllm-playground

# Switch to non-root user
USER 1001

# Expose web UI port
EXPOSE 7860

# Environment variables (can be overridden at runtime)
ENV WEBUI_PORT=7860 \
    KUBERNETES_NAMESPACE=vllm-playground

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:7860/api/status || exit 1

# Start web UI as an installed module (app.py must run as part of the
# vllm_playground package, not as a standalone script file).
CMD ["python3.12", "-m", "vllm_playground.app"]
